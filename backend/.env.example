# Copiá este archivo a .env y completá con tus valores locales.
# .env nunca se commitea al repo.

# PostgreSQL — ajustá usuario, password y nombre de base de datos según tu entorno local.
# Sin password:  postgresql://TU_USUARIO@localhost:5432/ismp
# Con password:  postgresql://TU_USUARIO:TU_PASSWORD@localhost:5432/ismp
DATABASE_URL="postgresql://TU_USUARIO@localhost:5432/ismp"

# Secreto para firmar los JWT. Puede ser cualquier string en desarrollo.
JWT_SECRET="dev-secret-ismp-2026"

# Puerto del servidor NestJS (el frontend apunta a este puerto).
PORT=3001
